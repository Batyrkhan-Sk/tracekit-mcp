# Frontend Bug Investigator MCP - configuration.
# All variables are optional; the values shown are the defaults unless noted.
# MCP clients usually pass these in the server's "env" block instead of a .env file.

# Comma-separated host patterns the browser may contact (exact host or *.example.com).
# Empty = any PUBLIC host. Strongly recommended for anything beyond local experiments.
INVESTIGATOR_ALLOWED_HOSTS=

# Comma-separated exact origins that may resolve to private/loopback addresses,
# e.g. a local dev server. Example: http://127.0.0.1:4173,http://localhost:5173
INVESTIGATOR_ALLOWED_LOCAL_ORIGINS=

# Allow POST/PUT/PATCH/DELETE from the page and clicks on destructive-looking controls.
INVESTIGATOR_ALLOW_MUTATING_REQUESTS=false

# Resource limits.
INVESTIGATOR_MAX_CONCURRENT=2
INVESTIGATOR_MAX_RETAINED=20
INVESTIGATOR_DEFAULT_DURATION_SECONDS=300
INVESTIGATOR_MAX_DURATION_SECONDS=900
INVESTIGATOR_RETENTION_SECONDS=3600
INVESTIGATOR_ACTION_TIMEOUT_MS=10000
INVESTIGATOR_MAX_ACTION_TIMEOUT_MS=60000
INVESTIGATOR_MAX_SCREENSHOTS=20

# Where screenshots and exported reports are written (default: <os tmpdir>/frontend-bug-investigator-artifacts).
INVESTIGATOR_ARTIFACTS_DIR=

INVESTIGATOR_HEADLESS=true
# error | warn | info | debug (logs go to stderr only)
INVESTIGATOR_LOG_LEVEL=info
