{
  "name": "tracekit-mcp",
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "description": "MCP server that investigates frontend bugs in a controlled browser, collects sanitized evidence, diagnoses probable causes and generates Playwright regression tests.",
  "license": "MIT",
  "author": "Batyr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Batyrkhan-Sk/tracekit-mcp.git"
  },
  "homepage": "https://github.com/Batyrkhan-Sk/tracekit-mcp#readme",
  "bugs": {
    "url": "https://github.com/Batyrkhan-Sk/tracekit-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "frontend",
    "debugging",
    "bug-report",
    "regression-test",
    "claude"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "tracekit-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:protocol": "vitest run tests/protocol",
    "browsers:install": "playwright install chromium",
    "demo:app": "tsx examples/faulty-catalog-app/server.ts",
    "demo": "npm run build && tsx scripts/run-demo.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "live:check": "npm run build && tsx scripts/live-check.ts",
    "live:enterprise": "npm run build && tsx scripts/live-enterprise.ts",
    "skill:pack": "tsx scripts/pack-skill.ts"
  }
}
